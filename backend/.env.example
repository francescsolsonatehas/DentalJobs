# Copia este archivo a .env y rellena los valores.
# El archivo .env está en .gitignore: NUNCA se commitea.

# Puerto del servidor (Render lo inyecta automáticamente)
PORT=3000

# Entorno: development | test | production
NODE_ENV=development

# Secreto para firmar los JWT. OBLIGATORIO en producción.
# Generar con: openssl rand -hex 32
JWT_SECRET=

# Cuánto dura la sesión antes de pedir login otra vez. Por defecto 30d.
# Acepta el formato de jsonwebtoken: "30d", "12h", "90d"…
JWT_EXPIRES_IN=

# --- Base de datos ---
# En desarrollo, sin configurar nada se usa el archivo local backend/dental_jobs.db.
# Turso SOLO se usa cuando NODE_ENV=production (aunque estas variables estén
# rellenas en local, el servidor de desarrollo seguirá usando el archivo local).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Alternativa: ruta a un archivo SQLite concreto
# DB_PATH=/ruta/al/archivo.db

# --- Correo (API HTTP de Brevo) ---
# Sin BREVO_API_KEY, los emails se imprimen por consola (modo desarrollo).
# Render bloquea las conexiones SMTP salientes, así que el correo va por
# HTTPS en vez de SMTP.
BREVO_API_KEY=
# Dirección remitente (debe estar verificada en Brevo)
GMAIL_USER=dentaljobs.avisos@gmail.com

# --- CORS ---
# Origen permitido del frontend en producción (GitHub Pages)
CORS_ORIGIN=https://tuusuario.github.io

# URL pública del frontend: base de los enlaces que van dentro de los correos
# (verificación, restablecer contraseña). En local, la del propio backend.
FRONTEND_URL=http://localhost:3000/

# --- Administración ---
# Token secreto para los endpoints /admin/* (verificación manual de nº de
# colegiado). Sin él, esos endpoints devuelven 401 siempre.
# Generar con: openssl rand -hex 32
ADMIN_TOKEN=
